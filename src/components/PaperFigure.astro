---
/*
  Placeholder headline figure for a paper card. On-brand abstract graphic (a mini
  spectral-bar motif tinted by the card's accent colour) with a clear placeholder
  label. Deterministic per seed so each paper looks distinct. Replace with the real
  figure at release.
*/
interface Props { seed?: number; }
const { seed = 0 } = Astro.props;
const W = 200, H = 140, base = 116, nb = 24;
const bw = W / nb;
const bars = Array.from({ length: nb }, (_, i) => {
  const v = Math.abs(Math.sin((i + 1) * 0.7 + seed * 1.3) * Math.cos((i + 1) * 0.41 + seed * 0.9));
  return Math.min(100, 14 + v * 92);
});
---
<figure class="pfig">
  <svg viewBox={`0 0 ${W} ${H}`} preserveAspectRatio="none" aria-hidden="true">
    {bars.map((h, i) => (
      <rect
        x={(i * bw + bw * 0.18).toFixed(1)} y={(base - h).toFixed(1)}
        width={(bw * 0.64).toFixed(1)} height={h.toFixed(1)} rx="0.6"
        fill="var(--accent)" opacity={(0.32 + 0.5 * (h / 100)).toFixed(2)}
      />
    ))}
    <line x1="0" y1={base} x2={W} y2={base} stroke="var(--mist)" stroke-opacity="0.25" stroke-width="1" />
  </svg>
  <figcaption class="pfig-cap mono">Headline figure &middot; placeholder</figcaption>
</figure>

<style>
  .pfig {
    position: relative; margin: 0; background: var(--ink);
    border-radius: 4px; overflow: hidden; aspect-ratio: 4 / 3;
  }
  .pfig svg { display: block; width: 100%; height: 100%; }
  .pfig-cap {
    position: absolute; left: 0.6rem; bottom: 0.5rem;
    font-size: 0.58rem; letter-spacing: 0.08em; text-transform: uppercase; color: var(--fog);
  }
</style>
