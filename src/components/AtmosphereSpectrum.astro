---
/*
  Redox veil: a layered, translucent ensemble of synthetic spectra spanning a mantle
  redox sequence (reduced -> oxidised), coloured along the Interra strata colormap.
  Stylised brand visual, not a chart: no axes, no labels. The colour gradient is the
  redox axis; the spread is the retrieval uncertainty. The central best-fit model
  glows through in amber. Edges fade into the ink. Pure inline SVG.
*/
const W = 1000, H = 190;
const padL = 6, padR = 6, padT = 26, padB = 18;
const x0 = padL, x1 = W - padR;
const yTop = padT, yBot = H - padB;
const lamMin = 0.6, lamMax = 5.2;

// Redox-dependent feature set: t = 0 reduced -> t = 1 oxidised.
function featuresAt(t) {
  const red = 1 - t;
  return [
    { mu: 0.95, sigma: 0.11, amp: 16 * red },
    { mu: 1.40, sigma: 0.12, amp: 20 + 36 * t },
    { mu: 1.65, sigma: 0.10, amp: 30 * red },
    { mu: 1.90, sigma: 0.14, amp: 18 + 28 * t },
    { mu: 2.35, sigma: 0.13, amp: 34 * red },
    { mu: 2.70, sigma: 0.18, amp: 22 + 40 * t },
    { mu: 3.30, sigma: 0.16, amp: 12 + 62 * red },
    { mu: 4.05, sigma: 0.12, amp: 72 * Math.pow(t, 1.4) },
    { mu: 4.30, sigma: 0.17, amp: 22 + 86 * t },
    { mu: 4.65, sigma: 0.10, amp: 16 + 40 * red },
  ];
}
function hash(n) { const s = Math.sin(n * 127.1 + 311.7) * 43758.5453; return s - Math.floor(s); }
function specVal(lam, t) {
  let v = 72 + 4 * (lam - lamMin) + 26 * Math.exp(-(lam - lamMin) / 0.5);
  for (const f of featuresAt(t)) v += f.amp * Math.exp(-((lam - f.mu) ** 2) / (2 * f.sigma ** 2));
  return v;
}
function envStrength(lam, t) {
  let m = 0;
  for (const f of featuresAt(t)) m += f.amp * Math.exp(-((lam - f.mu) ** 2) / (2 * f.sigma ** 2));
  return Math.min(1, m / 100);
}
function specFine(lam, i, t, seed) {
  const es = envStrength(lam, t);
  const ph = seed * 1.7;
  const s = Math.sin(lam * 55 + ph) * 2.0 + Math.sin(lam * 101 + 0.9 + ph) * 1.5
          + Math.sin(lam * 181 + 2.3 + ph) * 1.1 + Math.sin(lam * 293 + 1.1 + ph) * 0.8;
  const jitter = (hash(i + seed * 733) - 0.5) * 2;
  return s * (0.4 + 1.0 * es) + jitter * (0.9 + 3.2 * es);
}
const N = 520;
function sampleSpectrum(t, seed) {
  const arr = [];
  for (let i = 0; i < N; i++) {
    const lam = lamMin + (lamMax - lamMin) * (i / (N - 1));
    arr.push({ lam, v: specVal(lam, t) + specFine(lam, i, t, seed) });
  }
  return arr;
}

// Interra strata colormap as the redox axis (reduced gold -> oxidised cobalt).
const STOPS = ['#F0BA5E', '#DE7037', '#A23E3C', '#6A2A4D', '#3E5B86'];
function hex2rgb(h) { return [parseInt(h.slice(1, 3), 16), parseInt(h.slice(3, 5), 16), parseInt(h.slice(5, 7), 16)]; }
function rgb2hex(r) { return '#' + r.map(x => Math.round(x).toString(16).padStart(2, '0')).join(''); }
function redoxColor(t) {
  const x = Math.max(0, Math.min(1, t)) * (STOPS.length - 1);
  const i = Math.min(STOPS.length - 2, Math.floor(x));
  const f = x - i, a = hex2rgb(STOPS[i]), b = hex2rgb(STOPS[i + 1]);
  return rgb2hex([a[0] + (b[0] - a[0]) * f, a[1] + (b[1] - a[1]) * f, a[2] + (b[2] - a[2]) * f]);
}

const nSpec = 20;
const ensemble = [];
for (let k = 0; k < nSpec; k++) {
  const t = k / (nSpec - 1);
  ensemble.push({ t, samples: sampleSpectrum(t, k + 1), color: redoxColor(t) });
}
const central = sampleSpectrum(0.5, 99);

const allV = central.map(r => r.v).concat(...ensemble.map(e => e.samples.map(r => r.v)));
const vmin = Math.min(...allV), vmax = Math.max(...allV);
const Rng = vmax - vmin;
const lo = vmin - 0.06 * Rng, hi = vmax + 0.10 * Rng;
const sx = (lam) => x0 + (x1 - x0) * (lam - lamMin) / (lamMax - lamMin);
const sy = (v) => yBot - (yBot - yTop) * (v - lo) / (hi - lo);
const toPath = (arr) => 'M ' + arr.map(r => `${sx(r.lam).toFixed(1)} ${sy(r.v).toFixed(1)}`).join(' L ');

const ensemblePaths = ensemble.map(e => ({ d: toPath(e.samples), color: e.color }));
const centralPath = toPath(central);
const centralArea = `${centralPath} L ${x1} ${yBot} L ${x0} ${yBot} Z`;
---
<svg
  class="atmo-spectrum"
  viewBox={`0 0 ${W} ${H}`}
  preserveAspectRatio="none"
  role="img"
  aria-label="Stylised ensemble of synthetic spectra across a reduced-to-oxidised redox sequence, coloured along the Interra palette"
>
  <defs>
    <linearGradient id="atmoFill" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0%" stop-color="var(--amber)" stop-opacity="0.16" />
      <stop offset="100%" stop-color="var(--amber)" stop-opacity="0" />
    </linearGradient>
    <linearGradient id="edgeFade" x1="0" y1="0" x2="1" y2="0">
      <stop offset="0%" stop-color="#000" /><stop offset="7%" stop-color="#fff" />
      <stop offset="93%" stop-color="#fff" /><stop offset="100%" stop-color="#000" />
    </linearGradient>
    <mask id="fadeMask"><rect x="0" y="0" width={W} height={H} fill="url(#edgeFade)" /></mask>
    <filter id="softGlow" x="-10%" y="-60%" width="120%" height="220%">
      <feGaussianBlur stdDeviation="2.4" result="b" /><feMerge><feMergeNode in="b" /><feMergeNode in="SourceGraphic" /></feMerge>
    </filter>
  </defs>

  <g mask="url(#fadeMask)">
    {ensemblePaths.map(p => (
      <path d={p.d} fill="none" stroke={p.color} stroke-opacity="0.28" stroke-width="1.1" stroke-linejoin="round" />
    ))}
    <path d={centralArea} fill="url(#atmoFill)" />
    <path d={centralPath} fill="none" stroke="var(--amber)" stroke-width="2" stroke-linejoin="round" stroke-linecap="round" filter="url(#softGlow)" />
  </g>
</svg>

<style>
  .atmo-spectrum { width: 100%; height: 150px; display: block; overflow: visible; }
  @media (max-width: 700px) { .atmo-spectrum { height: 110px; } }
</style>
