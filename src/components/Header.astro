---
const nav = [
  { label: 'Science', href: '/science' },
  { label: 'Collaboration', href: '/collaboration' },
  { label: 'Data', href: '/data' },
  { label: 'Papers', href: '/papers' },
  { label: 'Contact', href: '/contact' },
];
const path = Astro.url.pathname.replace(/\/$/, '') || '/';
---
<header class="site-header">
  <div class="container header-inner">
    <a href="/" class="brand" aria-label="Interra Project home">
      <img src="/img/logo/logo_interra_base.svg" alt="" class="brand-mark" width="40" height="40" />
      <span class="brand-word">Interra Project</span>
    </a>
    <input type="checkbox" id="nav-toggle" class="nav-toggle" hidden />
    <label for="nav-toggle" class="nav-burger" aria-label="Toggle navigation">
      <span></span><span></span><span></span>
    </label>
    <nav class="site-nav" aria-label="Primary">
      {nav.map((n) => (
        <a href={n.href} class={path === n.href ? 'active' : ''}>{n.label}</a>
      ))}
    </nav>
  </div>
  <hr class="strata-rule" aria-hidden="true" />
</header>

<style>
  .site-header {
    position: sticky; top: 0; z-index: 50;
    background: var(--paper);
    box-shadow: 0 1px 0 color-mix(in srgb, var(--graphite) 8%, transparent);
  }
  .header-inner {
    display: flex; align-items: center; justify-content: space-between;
    min-height: 68px; gap: 1rem;
  }
  .brand { display: flex; align-items: center; gap: 0.6rem; }
  .brand:hover { text-decoration: none; }
  .brand-mark { height: 38px; width: auto; }
  .brand-word {
    font-family: var(--font-display); font-weight: 600;
    font-size: 1.15rem; letter-spacing: -0.01em; color: var(--ink);
    line-height: 1;
  }
  @media (max-width: 420px) { .brand-word { display: none; } }

  .site-nav { display: flex; gap: 1.75rem; align-items: center; }
  .site-nav a {
    font-family: var(--font-mono);
    font-size: 0.8rem; letter-spacing: 0.06em; text-transform: uppercase;
    color: var(--graphite); font-weight: 500;
  }
  .site-nav a:hover { color: var(--accent); text-decoration: none; }
  .site-nav a.active { color: var(--accent); }
  .site-nav a.active::after {
    content: ''; display: block; height: 2px; background: var(--accent);
    margin-top: 3px;
  }

  .nav-toggle, .nav-burger { display: none; }
  .nav-burger { flex-direction: column; gap: 5px; cursor: pointer; padding: 6px; }
  .nav-burger span { width: 24px; height: 2px; background: var(--graphite); display: block; }

  @media (max-width: 760px) {
    .nav-burger { display: flex; }
    .site-nav {
      position: absolute; top: 100%; left: 0; right: 0;
      flex-direction: column; align-items: flex-start; gap: 0;
      background: var(--paper); padding: 0 var(--gutter);
      max-height: 0; overflow: hidden; transition: max-height 0.25s ease;
      border-bottom: 1px solid var(--divider);
    }
    .site-nav a { padding: 0.85rem 0; width: 100%; border-bottom: 1px solid var(--divider); }
    .nav-toggle:checked ~ .site-nav { max-height: 22rem; }
  }
</style>
