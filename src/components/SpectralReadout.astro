---
/*
  Spectral-readout motif: a strip of vertical bars in the strata palette.
  Signature graphic for ensemble identifiers and banner figures.
  Bar heights here are decorative; in data contexts they can encode a quantity.
*/
interface Props {
  bars?: number;
  class?: string;
}
const { bars = 48, class: klass = '' } = Astro.props;
const cycle = ['gold', 'amber', 'magma', 'plum', 'cobalt', 'ink'];
// Deterministic pseudo-heights so the build is reproducible (no Math.random at build time).
const heights = Array.from({ length: bars }, (_, i) => {
  const v = Math.abs(Math.sin(i * 1.7) * Math.cos(i * 0.6));
  return 28 + Math.round(v * 72);
});
---
<div class={`spectral ${klass}`} aria-hidden="true">
  {heights.map((h, i) => (
    <span style={`height:${h}%;background:var(--strata-${cycle[i % cycle.length]})`}></span>
  ))}
</div>

<style>
  .spectral {
    display: flex; align-items: flex-end; gap: 2px;
    height: 64px; width: 100%; overflow: hidden;
  }
  .spectral span { flex: 1; min-width: 2px; border-radius: 1px 1px 0 0; opacity: 0.9; }
</style>
