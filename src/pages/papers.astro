---
import Base from '../layouts/Base.astro';
import StrataBand from '../components/StrataBand.astro';
import PaperFigure from '../components/PaperFigure.astro';
import { papers } from '../data/papers.js';

// Exclude 'ink' so the accent stays visible on the dark figure panel and light cards.
const strata = ['gold', 'amber', 'magma', 'plum', 'cobalt'];
---
<Base title="Papers" description="The first papers of the Interra 2027 Release.">
  <section class="section page-head">
    <div class="container">
      <p class="eyebrow">Interra 2027 Release</p>
      <h1>The first Interra papers.</h1>
      <p class="lead">
        The inaugural set of Interra publications, released openly alongside the first
        model ensembles. Each paper can be read as a plain-language overview or as its
        full abstract.
      </p>
      <p class="provisional mono">Provisional &middot; titles and text are finalised at release.</p>
    </div>
  </section>

  <StrataBand variant="rule" />

  <section class="section">
    <div class="container">
      <ul class="papers">
        {papers.map((p, i) => (
          <li class="paper" data-view="lay" style={`--accent: var(--strata-${strata[i % strata.length]})`}>
            <PaperFigure seed={i} />
            <div class="paper-content">
              <div class="paper-head">
                <span class="paper-n mono">{p.n}</span>
                <div>
                  <p class="paper-eyebrow mono">Interra 2027 Release &middot; {p.status}</p>
                  <h2 class="paper-title">{p.title}</h2>
                  <p class="paper-authors mono">{p.authors}</p>
                </div>
              </div>

              <div class="paper-switch" role="tablist" aria-label="Show summary or abstract">
                <button class="psw-btn is-active" data-view="lay" role="tab" aria-selected="true">At a glance</button>
                <button class="psw-btn" data-view="abstract" role="tab" aria-selected="false">Abstract</button>
                <span class="psw-thumb" aria-hidden="true"></span>
              </div>

              <div class="paper-body">
                <p class="panel panel-lay">{p.lay}</p>
                <p class="panel panel-abstract">{p.abstract}</p>
              </div>
            </div>
          </li>
        ))}
      </ul>
    </div>
  </section>
</Base>

<script is:inline>
  (function () {
    document.querySelectorAll('.paper').forEach(function (card) {
      var btns = card.querySelectorAll('.psw-btn');
      btns.forEach(function (b) {
        b.addEventListener('click', function () {
          card.setAttribute('data-view', b.getAttribute('data-view'));
          btns.forEach(function (o) {
            var on = o === b;
            o.classList.toggle('is-active', on);
            o.setAttribute('aria-selected', on ? 'true' : 'false');
          });
        });
      });
    });
  })();
</script>

<style>
  .page-head { padding-bottom: 2rem; }
  .provisional { color: var(--fog); font-size: 0.72rem; letter-spacing: 0.04em; margin-top: 0.75rem; }

  .papers { list-style: none; padding: 0; margin: 0; }
  .paper {
    display: grid; grid-template-columns: 230px 1fr; gap: 1.75rem; align-items: start;
    border-left: 3px solid var(--accent); background: var(--surface);
    border-radius: 0 4px 4px 0; padding: 1.6rem 1.9rem; margin-bottom: 1.5rem;
  }
  @media (max-width: 700px) { .paper { grid-template-columns: 1fr; gap: 1.1rem; } }

  .paper-head { display: flex; gap: 1.25rem; align-items: flex-start; }
  .paper-n { font-size: 1.6rem; font-weight: 700; color: var(--accent); line-height: 1; flex: 0 0 auto; min-width: 1.5em; }
  .paper-eyebrow { font-size: 0.68rem; letter-spacing: 0.08em; text-transform: uppercase; color: var(--fog); margin: 0 0 0.4rem; }
  .paper-title { font-size: 1.35rem; color: var(--ink); margin: 0 0 0.5rem; line-height: 1.25; }
  .paper-authors { font-size: 0.78rem; color: var(--fog); margin: 0; }

  /* Per-paper switch */
  .paper-switch {
    position: relative; display: inline-flex; margin: 1.1rem 0 0;
    background: var(--paper); border: 1px solid var(--divider); border-radius: 999px; padding: 3px;
  }
  .psw-btn {
    position: relative; z-index: 1; border: none; background: transparent; cursor: pointer;
    font-family: var(--font-mono); font-size: 0.7rem; letter-spacing: 0.03em;
    padding: 0.35rem 0.95rem; border-radius: 999px; color: var(--graphite); transition: color 0.2s ease;
  }
  .psw-btn.is-active { color: var(--paper); }
  .psw-thumb {
    position: absolute; z-index: 0; top: 3px; bottom: 3px; left: 3px; width: calc(50% - 3px);
    background: var(--amber); border-radius: 999px; transition: transform 0.2s ease;
  }
  .paper[data-view="abstract"] .psw-thumb { transform: translateX(100%); }

  .paper-body { margin-top: 1rem; }
  .panel { font-size: var(--t-body-l); color: var(--graphite); margin: 0; max-width: 72ch; }
  .paper[data-view="lay"] .panel-abstract { display: none; }
  .paper[data-view="abstract"] .panel-lay { display: none; }

  @media (max-width: 560px) {
    .paper-head { gap: 0.85rem; }
    .paper-n { font-size: 1.3rem; }
    .paper-title { font-size: 1.15rem; }
  }
</style>
