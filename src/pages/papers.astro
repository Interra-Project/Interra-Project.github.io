---
import Base from '../layouts/Base.astro';
import StrataBand from '../components/StrataBand.astro';
import { papers } from '../data/papers.js';

const strata = ['gold', 'amber', 'magma', 'plum', 'cobalt', 'ink'];
---
<Base title="Papers" description="The first papers of the Interra 2027 Release.">
  <section class="section page-head">
    <div class="container">
      <p class="eyebrow">Interra 2027 Release</p>
      <h1>The first Interra papers.</h1>
      <p class="lead">
        The inaugural set of Interra publications, released openly alongside the first
        model ensembles. Switch between a plain-language overview and the full abstract.
      </p>
      <p class="provisional mono">Provisional &middot; titles and text are finalised at release.</p>
    </div>
  </section>

  <StrataBand variant="rule" />

  <section class="section">
    <div class="container">
      <div class="switch" role="tablist" aria-label="Show summary or abstract">
        <button class="switch-btn is-active" data-view="lay" role="tab" aria-selected="true">At a glance</button>
        <button class="switch-btn" data-view="abstract" role="tab" aria-selected="false">Abstract</button>
        <span class="switch-thumb" aria-hidden="true"></span>
      </div>

      <ul class="papers" id="papers" data-view="lay">
        {papers.map((p, i) => (
          <li class="paper" style={`--accent: var(--strata-${strata[i % strata.length]})`}>
            <div class="paper-head">
              <span class="paper-n mono">{p.n}</span>
              <div>
                <p class="paper-eyebrow mono">Interra 2027 Release &middot; {p.status}</p>
                <h2 class="paper-title">{p.title}</h2>
                <p class="paper-authors mono">{p.authors}</p>
              </div>
            </div>
            <div class="paper-body">
              <p class="panel panel-lay"><span class="panel-label mono">At a glance</span>{p.lay}</p>
              <p class="panel panel-abstract"><span class="panel-label mono">Abstract</span>{p.abstract}</p>
            </div>
          </li>
        ))}
      </ul>
    </div>
  </section>
</Base>

<script is:inline>
  (function () {
    const list = document.getElementById('papers');
    const btns = document.querySelectorAll('.switch-btn');
    btns.forEach((b) => b.addEventListener('click', () => {
      const view = b.getAttribute('data-view');
      list.setAttribute('data-view', view);
      btns.forEach((o) => {
        const on = o === b;
        o.classList.toggle('is-active', on);
        o.setAttribute('aria-selected', on ? 'true' : 'false');
      });
    }));
  })();
</script>

<style>
  .page-head { padding-bottom: 2rem; }
  .provisional { color: var(--fog); font-size: 0.72rem; letter-spacing: 0.04em; margin-top: 0.75rem; }

  /* Segmented switch */
  .switch {
    position: relative; display: inline-flex; gap: 0; margin-bottom: 2.5rem;
    background: var(--surface); border: 1px solid var(--divider); border-radius: 999px; padding: 4px;
  }
  .switch-btn {
    position: relative; z-index: 1; border: none; background: transparent; cursor: pointer;
    font-family: var(--font-mono); font-size: 0.78rem; letter-spacing: 0.04em;
    padding: 0.5rem 1.25rem; border-radius: 999px; color: var(--graphite); transition: color 0.2s ease;
  }
  .switch-btn.is-active { color: var(--paper); }
  .switch-thumb {
    position: absolute; z-index: 0; top: 4px; bottom: 4px; left: 4px; width: calc(50% - 4px);
    background: var(--amber); border-radius: 999px; transition: transform 0.22s ease;
  }
  .switch:has(.switch-btn[data-view="abstract"].is-active) .switch-thumb { transform: translateX(100%); }

  /* Papers */
  .papers { list-style: none; padding: 0; margin: 0; }
  .paper {
    border-left: 3px solid var(--accent); background: var(--surface);
    border-radius: 0 4px 4px 0; padding: 1.75rem 1.9rem; margin-bottom: 1.5rem;
  }
  .paper-head { display: flex; gap: 1.25rem; align-items: flex-start; }
  .paper-n { font-size: 1.6rem; font-weight: 700; color: var(--accent); line-height: 1; flex: 0 0 auto; min-width: 1.5em; }
  .paper-eyebrow { font-size: 0.68rem; letter-spacing: 0.08em; text-transform: uppercase; color: var(--fog); margin: 0 0 0.4rem; }
  .paper-title { font-size: 1.35rem; color: var(--ink); margin: 0 0 0.5rem; line-height: 1.25; }
  .paper-authors { font-size: 0.78rem; color: var(--fog); margin: 0; }

  .paper-body { margin-top: 1.1rem; }
  .panel { font-size: var(--t-body-l); color: var(--graphite); margin: 0; max-width: 72ch; }
  .panel-label {
    display: block; font-size: 0.62rem; letter-spacing: 0.12em; text-transform: uppercase;
    color: var(--accent); margin-bottom: 0.4rem;
  }
  .papers[data-view="lay"] .panel-abstract { display: none; }
  .papers[data-view="abstract"] .panel-lay { display: none; }

  @media (max-width: 560px) {
    .paper-head { gap: 0.85rem; }
    .paper-n { font-size: 1.3rem; }
    .paper-title { font-size: 1.15rem; }
  }
</style>
