---
import Base from '../layouts/Base.astro';
---
<Base title="Page not found" description="The page you were looking for does not exist.">
  <section class="section nf">
    <div class="container">
      <p class="eyebrow">404</p>
      <h1>This page drifted off the map.</h1>
      <p class="lead">The page you were looking for does not exist or has moved.</p>
      <p><a href="/" class="btn btn--solid">Back to home</a></p>
    </div>
  </section>
</Base>

<style>
  .nf { padding-block: clamp(4rem, 12vw, 9rem); }
</style>
